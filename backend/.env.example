# ==========================================================
# Smart Air Monitor System — Environment Configuration
# Copy this file to `.env` and fill in real values.
# ==========================================================

# --- Core ---
SECRET_KEY=change-this-to-a-random-50-char-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Set USE_SQLITE=True for local development (no Postgres needed).
USE_SQLITE=True
DB_NAME=smart_air_monitor
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins (your Next.js/frontend dev servers)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (optional, used for password reset / approval notifications) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@smartairmonitor.local

# --- Superuser bootstrap (used by seed_data management command) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@smartair.com
DJANGO_SUPERUSER_PASSWORD=Admin@12345
